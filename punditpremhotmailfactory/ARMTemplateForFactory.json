{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "punditpremhotmailfactory"
		},
		"atlas_adls2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://punditpremhotmailgeneral.dfs.core.windows.net/"
		},
		"kv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvpunditpremhotmail.vault.azure.net/"
		},
		"dwh_ldw_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "punditpremhotmail.database.windows.net"
		},
		"dwh_ldw_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ldw"
		},
		"dwh_ldw_properties_typeProperties_servicePrincipalId": {
			"type": "string",
			"defaultValue": "408bcee5-7e82-4a2d-8cd0-aed0a7a50e76"
		},
		"dwh_ldw_properties_typeProperties_tenant": {
			"type": "string",
			"defaultValue": "09d8c1f2-325c-40a0-96c0-532304956c8f"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/import_atlas_all')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Customers",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"fileListPath": "root/atlas/customers.csv",
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							},
							"sink": {
								"type": "AzureSqlSink",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"tableOption": "autoCreate",
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "csv_customer",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "tbl_customer",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"sys_run_type": {
						"type": "string",
						"defaultValue": "eod"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/csv_customer')]",
				"[concat(variables('factoryId'), '/datasets/tbl_customer')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/atlas_adls2')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('atlas_adls2_properties_typeProperties_url')]",
					"credential": {
						"referenceName": "dev_spn",
						"type": "CredentialReference"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/credentials/dev_spn')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/kv')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('kv_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/dev_spn')]",
			"type": "Microsoft.DataFactory/factories/credentials",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "ServicePrincipal",
				"typeProperties": {
					"tenant": "09d8c1f2-325c-40a0-96c0-532304956c8f",
					"servicePrincipalId": "408bcee5-7e82-4a2d-8cd0-aed0a7a50e76",
					"servicePrincipalKey": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "kv",
							"type": "LinkedServiceReference"
						},
						"secretName": "devspn"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/kv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/dwh_ldw')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('dwh_ldw_properties_typeProperties_server')]",
					"database": "[parameters('dwh_ldw_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": true,
					"authenticationType": "ServicePrincipal",
					"servicePrincipalId": "[parameters('dwh_ldw_properties_typeProperties_servicePrincipalId')]",
					"servicePrincipalCredential": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "kv",
							"type": "LinkedServiceReference"
						},
						"secretName": "devspn"
					},
					"tenant": "[parameters('dwh_ldw_properties_typeProperties_tenant')]"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/kv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/dev_spn_azure_sql')]",
			"type": "Microsoft.DataFactory/factories/credentials",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "ServicePrincipal",
				"typeProperties": {
					"tenant": "09d8c1f2-325c-40a0-96c0-532304956c8f",
					"servicePrincipalId": "408bcee5-7e82-4a2d-8cd0-aed0a7a50e76",
					"servicePrincipalKey": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "kv",
							"type": "LinkedServiceReference"
						},
						"secretName": "devspn"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/kv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/csv_customer')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "atlas_adls2",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/atlas_adls2')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/tbl_customer')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "dwh_ldw",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": "atlas",
					"table": "customers"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/dwh_ldw')]"
			]
		}
	]
}