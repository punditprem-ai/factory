{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "punditpremhotmailfactory"
		},
		"atlas_adls2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://punditpremhotmailgeneral.dfs.core.windows.net/"
		},
		"kv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvpunditpremhotmail.vault.azure.net/"
		},
		"dwh_ldw_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "punditpremhotmail.database.windows.net"
		},
		"dwh_ldw_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ldw"
		},
		"dwh_ldw_properties_typeProperties_servicePrincipalId": {
			"type": "string",
			"defaultValue": "408bcee5-7e82-4a2d-8cd0-aed0a7a50e76"
		},
		"dwh_ldw_properties_typeProperties_tenant": {
			"type": "string",
			"defaultValue": "09d8c1f2-325c-40a0-96c0-532304956c8f"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "punditpremhotmailfactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"kv_properties_typeProperties_baseUrl": {
						"value": "[parameters('kv_properties_typeProperties_baseUrl')]"
					},
					"dwh_ldw_properties_typeProperties_server": {
						"value": "[parameters('dwh_ldw_properties_typeProperties_server')]"
					},
					"dwh_ldw_properties_typeProperties_database": {
						"value": "[parameters('dwh_ldw_properties_typeProperties_database')]"
					},
					"dwh_ldw_properties_typeProperties_servicePrincipalId": {
						"value": "[parameters('dwh_ldw_properties_typeProperties_servicePrincipalId')]"
					},
					"dwh_ldw_properties_typeProperties_tenant": {
						"value": "[parameters('dwh_ldw_properties_typeProperties_tenant')]"
					},
					"atlas_adls2_properties_typeProperties_url": {
						"value": "[parameters('atlas_adls2_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}